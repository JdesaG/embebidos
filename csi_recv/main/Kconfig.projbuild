menu "CSI Receiver Network"

config CSI_UDP_PORT
    int "UDP destination port"
    range 1 65535
    default 5000
    help
        Puerto de ingesta anunciado por el servidor. La IP se descubre
        automaticamente y no se guarda en el firmware.

config CSI_UDP_QUEUE_LENGTH
    int "UDP queue length"
    range 4 64
    default 32
    help
        Number of frames buffered between the CSI callback and UDP task.

endmenu
